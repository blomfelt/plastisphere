   "source": [
    "## Relative Abundances"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 111,
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "# Get readcount before deleting that row\n",
    "df_readcount <- df_counts[which(df_counts[, 1] == \"TOTAL READS:\"), ]\n",
    "df_counts <- df_counts[-which(df_counts$Description == \"TOTAL READS:\"), ]\n",
    "\n",
    "# Get relative abundances for each sample, separate for forward and reverse:\n",
    "df_relative <- df_counts %>%\n",
    "  mutate(across(ends_with('-Mut'), ~ . / (. + get(str_replace(cur_column(), \"-Mut$\", \"-WT\"))), .names = \"{.col}_relative\")) %>%\n",
    "  rename_at(vars(ends_with('_relative')), ~ str_remove(., \"\\\\_val-Mut\")) %>%\n",
    "  select(-ends_with(c(\"-Mut\", \"-WT\"))) %>%\n",
    "  rename_at(vars(ends_with('_relative')), ~ str_remove(., \"\\\\_relative\"))\n",
    "#head(df_relative)\n",
    "# Replace all NA:s with zeros?\n",
    "#df_relative %>%\n",
    "#  mutate_all(~replace(., is.na(.), 0)) %>%\n",
    "#  select(-Accession)\n",
    "\n",
    "# Identify Inf:s\n",
    "#df_counts[which(df_relative$DRR528401_1_relative == Inf), c(\"Accession\", \"DRR528401_1_val-Mut\", \"DRR528401_1_val-WT\", \"DRR528402_1_val-Mut\", \"DRR528402_1_val-WT\")]\n",
    "#df_relative[which(df_relative$DRR528401_1_relative == Inf), c(\"Accession\", \"DRR528401_1_relative\", \"DRR528402_1_relative\")]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
