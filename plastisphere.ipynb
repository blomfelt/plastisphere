     "data": {
      "text/html": [
       "<style>\n",
       ".list-inline {list-style: none; margin:0; padding: 0}\n",
       ".list-inline>li {display: inline-block}\n",
       ".list-inline>li:not(:last-child)::after {content: \"\\00b7\"; padding: 0 .5ex}\n",
       "</style>\n",
       "<ol class=list-inline><li>492</li><li>1573</li></ol>\n"
       "<ol class=list-inline><li>492</li><li>1573</li></ol>\n"
      ],
      "text/latex": [
