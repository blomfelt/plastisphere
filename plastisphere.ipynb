   },
   "source": [
    "## Transposing the dataframe"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 112,
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Dim unmodified: 786 492\n",
      "Dim filtered:   786 117"
     ]
    }
   ],
   "source": [
    "# Gives us a dataframe where row = sample and column = mutation\n",
    "df_transposed <- df_relative %>%\n",
    "    column_to_rownames(var = \"Description\") %>%\n",
    "    rownames_to_column() %>%  \n",
    "    pivot_longer(-rowname) %>% \n",
    "    pivot_wider(names_from=rowname, values_from=value) %>%\n",
    "    rename(Sample = name)\n",
    "\n",
    "# Replace all NA:s with zeros (copied from above), needed because '1 + NA = NA'\n",
    "df_transposed <- df_transposed %>%\n",
    "  mutate_all(~replace(., is.na(.), 0)) \n",
    "\n",
    "non_zero_count <- colSums(df_transposed != 0) # Count non-zero values per column\n",
    "selected_cols <- names(non_zero_count[non_zero_count > 10]) # Get column names with more than 3 non-zero values\n",
    "df_transposed_filtered <- df_transposed[, selected_cols] # Filter the table for selected columns\n",
    "cat(\"\\nDim unmodified: \"); cat(dim(df_transposed))\n",
    "cat(\"\\nDim filtered:   \"); cat(dim(df_transposed_filtered))"
   ]
  },
