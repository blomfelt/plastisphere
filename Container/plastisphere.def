Bootstrap: docker
From: ubuntu:22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    # Update OS and install packages
    apt-get update 
    apt-get install -y \
        git \
        wget \
        curl \
        r-base \
        original-awk \
        python3.11 \
        python3-pip \
        zlib1g-dev \
        fastqc
        # Nextflow cannot install without fastqc because of java?

    apt-get clean

    R -e 'install.packages("tidyverse")'

    # Install Nextflow 
    mkdir Nextflow
    cd Nextflow
    wget -qO- https://get.nextflow.io | bash
    chmod +x nextflow
    cd ..

    # Install Usearch 
    mkdir Usearch
    cd Usearch
    wget https://github.com/rcedgar/usearch_old_binaries/raw/refs/heads/main/bin/usearch11.0.667_i86linux64
    mv usearch* usearch
    chmod +x usearch
    cd ..

    # Install MuMaMe
    wget https://microbiology.se/sw/mumame_1.0b.tar.gz
    tar xvzf mumame_1.0b.tar.gz --no-same-owner
    mv MuMaMe_1.0b Mumame

%environment
    export LC_ALL=C
    export PATH=/Nextflow/:$PATH
